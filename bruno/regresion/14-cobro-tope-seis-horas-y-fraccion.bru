meta {
  name: Cobro con tope seis horas y fraccion
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/tickets/{{topeId}}/salida
  body: json
  auth: none
}

body:json {
  {
    "salida": "2026-10-22T14:01:00"
  }
}

assert {
  res.status: eq 200
  res.body.minutos: eq 361
  res.body.monto: eq 60
}

docs {
  Valor frontera del tope: 361 minutos son 7 horas o fraccion, Q70 sin tope. La regla dice que ningun ticket paga mas de Q60.
}
