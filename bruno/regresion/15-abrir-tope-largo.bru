meta {
  name: Abrir ticket para tope largo
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/tickets
  body: json
  auth: none
}

body:json {
  {
    "placa": "P555XYZ",
    "entrada": "2026-10-22T08:00:00"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("topeLargoId", res.body.id);
}
